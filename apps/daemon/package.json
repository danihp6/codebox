{
  "name": "@codebox/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build -w @codebox/contracts -w @codebox/core -w @codebox/security -w @codebox/store -w @codebox/opencode -w @codebox/workspaces -w @codebox/git-provider",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "cd ../.. && vitest run --project apps/daemon"
  },
  "dependencies": {
    "@codebox/contracts": "0.0.0",
    "@codebox/core": "0.0.0",
    "@codebox/git-provider": "0.0.0",
    "@codebox/opencode": "0.0.0",
    "@codebox/security": "0.0.0",
    "@codebox/store": "0.0.0",
    "@codebox/workspaces": "0.0.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13"
  }
}
