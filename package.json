{
  "name": "codebox",
  "version": "0.0.0",
  "private": true,
  "description": "Private control plane for OpenCode running on your own OCI VM, controlled by a hybrid Angular app.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "e2e": "playwright test --config e2e/playwright.config.mjs",
    "e2e:unit": "node --test \"e2e/unit/*.test.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:guard && npm run test:app && vitest run",
    "test:app": "npm test -w @codebox/app",
    "test:guard": "node scripts/test-guard.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
