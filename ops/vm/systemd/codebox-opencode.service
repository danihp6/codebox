[Unit]
Description=Codebox OpenCode server on loopback
After=network-online.target
Wants=network-online.target

[Service]
User=codebox
Group=codebox
WorkingDirectory=/var/lib/codebox
EnvironmentFile=/etc/codebox/instance.env
ExecStart=/usr/bin/env opencode serve --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
PrivateDevices=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0027
ReadWritePaths=/var/lib/codebox /srv/codebox

# No install section on purpose: the daemon may own the OpenCode child itself, so the unit
# exists for crash isolation and is started only when the daemon is not the parent.
