# /etc/codebox/cb-agent.env, 0600 root:cb-agent
# Copy to the path in CB_AGENT_ENV (default /etc/codebox/cb-agent.env) and fill it in.
# This file is a template: it must never contain a real credential in the repository.

# The model every role runs on (`provider/model`). Required.
CB_AGENT_MODEL=

# The provider key for that model, under the name OpenCode reads.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OPENCODE_API_KEY=

# The pipeline's only durable git credential on the box: contents: write + issues: write,
# this repository only. Required on the VM. On Actions the cycle checks out with the
# CB_AGENT_TOKEN PAT and GITHUB_TOKEN covers issues and dispatch.
CB_AGENT_GIT_TOKEN=

# Paths. The defaults match docs/agent-vm.md; override only if the box moved.
CB_AGENT_REPO=/srv/cb-agent/codebox
CB_AGENT_STATE=/var/lib/cb-agent
CB_AGENT_ENV=/etc/codebox/cb-agent.env

# A day's cap; 0 or unset means no cap.
CB_AGENT_DAILY_CYCLES=0

# Dev slots per wave, read by run-cycle.sh and passed to the prompt.
# Ceiling 4; 2 on the 2 OCPU box.
CB_AGENT_MAX_DEVS=2

# Merge to main at the end of a cycle. false stops after QA.
CB_AGENT_MERGE=true
